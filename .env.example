# Local prototype only. Do not put Azure passwords here.
# For Azure, fill key-vault-secrets.env (gitignored) and upload it to Key Vault.
# See docs/KEY-VAULT.md.

PORT=3000
NODE_ENV=development
VECTOR_BUILD=V2.3
STORAGE_DRIVER=excel

# Azure Web App — this is the ONLY setting the hosted app needs.
# The Web App Managed Identity then reads the rest from Key Vault.
# KEY_VAULT_URI=https://YOUR-VAULT-NAME.vault.azure.net/
