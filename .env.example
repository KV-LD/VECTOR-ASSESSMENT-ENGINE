# Copy to .env locally, or set these as Azure App Service Application Settings.

PORT=3000
NODE_ENV=development
VECTOR_BUILD=V2

# Secrets — change before any hosted deployment
JWT_SECRET=change-me-before-azure
ADMIN_JWT_SECRET=change-me-before-azure
ADMIN_EMAIL=admin@ust.com
ADMIN_PASSWORD=admin123

# Prototype storage (default). Keep excel for localhost.
# Switch to azure-sql after you have a database and credentials.
STORAGE_DRIVER=excel
VECTOR_DATA_FILE=

# Azure SQL (used only when STORAGE_DRIVER=azure-sql)
# Install the driver first: npm install mssql
AZURE_SQL_CONNECTION_STRING=

# Optional SMTP. If unset, the 6-digit OTP is shown on screen and in the terminal.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
