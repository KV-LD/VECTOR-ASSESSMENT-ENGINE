# App Mode: dev or prod
APP_MODE=dev

# Storage: excel or postgres
STORAGE_PROVIDER=excel
EXCEL_FILE_PATH=data/assessments.xlsx

# OTP: dev (console) or smtp (email)
OTP_MODE=dev
OTP_EXPIRY_MINUTES=10
OTP_RESEND_COOLDOWN=30
OTP_MAX_ATTEMPTS=5

# For production with SMTP:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password

# For production with Postgres:
# DATABASE_URL=postgresql://user:password@localhost:5432/vector_assessment
