# VECTOR Key Vault secrets
# -------------------------------------------------
# 1. Copy this file:
#      copy key-vault-secrets.env.example key-vault-secrets.env
# 2. Fill in the values on the RIGHT of each = sign.
# 3. Do NOT paste those values into chat, email, or git.
# 4. Upload with:
#      powershell -File scripts/Set-KeyVaultSecrets.ps1 -VaultName YOUR-VAULT-NAME
#
# Azure secret names are the LEFT side (hyphens). The app maps them to env vars.
# key-vault-secrets.env is gitignored.

# --- Storage (put this in Key Vault, not in chat) ---
STORAGE-DRIVER=postgres

# Prefer a single Azure Postgres connection string if you have one.
# Example: postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
POSTGRES-CONNECTION-STRING=

# Or fill these instead of the connection string (leave the string blank).
POSTGRES-HOST=
POSTGRES-PORT=5432
POSTGRES-DB=
POSTGRES-USER=
POSTGRES-PASSWORD=
POSTGRES-SSL=require

# --- Session secrets (leave blank to auto-generate on upload) ---
JWT-SECRET=
ADMIN-JWT-SECRET=

# --- Admin login for https://YOUR-APP.azurewebsites.net/admin ---
ADMIN-EMAIL=
ADMIN-PASSWORD=

# --- SMTP for OTP email ---
SMTP-HOST=
SMTP-PORT=587
SMTP-SECURE=0
SMTP-USER=
SMTP-PASS=
SMTP-FROM=

# Optional. App Service can also set this as an app setting.
VECTOR-BUILD=V2.3
